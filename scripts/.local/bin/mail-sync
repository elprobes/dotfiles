#!/usr/bin/env bash

set -euo pipefail

CACHE_DIR="$HOME/.cache/mail-sync"
STATE_FILE="$CACHE_DIR/last-message-id"

ICON_MAIL="<span size='x-large'></span>"
ICON_ATTACHMENT="<span size='x-large'>󰈙</span>"
ICON_OTP="<span size='x-large'>󰒃</span>"
ICON_MULTIPLE="<span size='x-large'>󰇮</span>"
ICON_UNREAD="<span size='x-large'></span>"
ICON_INDENT="➥"

escape_markup() {
    sed \
        -e 's/&/\&amp;/g' \
        -e 's/</\&lt;/g' \
        -e 's/>/\&gt;/g'
}

mkdir -p "$CACHE_DIR"

mbsync gmail >/dev/null
notmuch new >/dev/null 2>&1

mapfile -t IDS < <(
    notmuch search \
        --sort=newest-first \
        --output=messages \
        '*'
)

[[ ${#IDS[@]} -eq 0 ]] && exit 0

LATEST="${IDS[0]}"

if [[ ! -f "$STATE_FILE" ]]; then
    echo "$LATEST" >"$STATE_FILE"
    exit 0
fi

LAST=$(<"$STATE_FILE")

NEW_IDS=()

for id in "${IDS[@]}"; do
    [[ "$id" == "$LAST" ]] && break
    NEW_IDS+=("$id")
done

if [[ ${#NEW_IDS[@]} -eq 0 ]]; then
    notify-send \
        -u low \
        "󰄬 Sincronizzazione completata"
    exit 0
fi

UNREAD_COUNT=$(notmuch count tag:unread)

COUNT=${#NEW_IDS[@]}

if [[ "$COUNT" -eq 1 ]]; then

    JSON=$(notmuch show \
        --format=json \
        --entire-thread=false \
        "${NEW_IDS[0]}")

    FROM=$(jq -r '.[0][0][0].headers.From' <<<"$JSON")
    FROM=$(printf '%s\n' "$FROM" | sed -E 's/^(.*) <[^>]+>$/\1/')

    SUBJECT=$(jq -r '.[0][0][0].headers.Subject' <<<"$JSON")

    FROM=$(printf '%s' "$FROM" | escape_markup)
    SUBJECT=$(printf '%s' "$SUBJECT" | escape_markup)

    PREFIX="$ICON_MAIL"

    HAS_ATTACHMENT=$(
        jq -r '
                        .[0][0][0].tags
                        | index("attachment")
                        | if . == null then "no" else "yes" end
                        ' <<<"$JSON"
    )

    if [[ "$HAS_ATTACHMENT" == "yes" ]]; then
        PREFIX="$ICON_ATTACHMENT"
    fi

    OTP=$(grep -oE '\b[0-9]{6,8}\b' <<<"$SUBJECT" | head -1 || true)

    if [[ -n "$OTP" ]]; then

        notify-send \
            -a "Mail" \
            "$FROM" \
            "   $ICON_INDENT $OTP"$'\n'"$ICON_UNREAD Non letti: $UNREAD_COUNT"

    else

        notify-send \
            -a "Mail" \
            "$FROM" \
            "   $ICON_INDENT $SUBJECT"$'\n'"$ICON_UNREAD Non letti: $UNREAD_COUNT"
    fi

else

    BODY=""

    MAX=3
    SHOWN=0

    for id in "${NEW_IDS[@]}"; do

        [[ "$SHOWN" -ge "$MAX" ]] && break

        JSON=$(notmuch show \
            --format=json \
            --entire-thread=false \
            "$id")

        FROM=$(jq -r '.[0][0][0].headers.From' <<<"$JSON")
        FROM=$(printf '%s\n' "$FROM" | sed -E 's/^(.*) <[^>]+>$/\1/')

        SUBJECT=$(jq -r '.[0][0][0].headers.Subject' <<<"$JSON")

        FROM=$(printf '%s' "$FROM" | escape_markup)
        SUBJECT=$(printf '%s' "$SUBJECT" | escape_markup)

        ICON="$ICON_MULTIPLE"

        HAS_ATTACHMENT=$(
            jq -r '
                            .[0][0][0].tags
                            | index("attachment")
                            | if . == null then "no" else "yes" end
                            ' <<<"$JSON"
        )

        if [[ "$HAS_ATTACHMENT" == "yes" ]]; then
            ICON="$ICON_ATTACHMENT"
        fi

        OTP=$(grep -oE '\b[0-9]{6,8}\b' <<<"$SUBJECT" | head -1 || true)

        if [[ -n "$OTP" ]]; then
            ICON="$ICON_OTP"
            SUBJECT="Codice: $OTP"
        fi

        BODY+="$ICON $FROM"$'\n'
        BODY+="   $ICON_INDENT $SUBJECT"$'\n\n'

        ((SHOWN += 1))

    done

    if [[ "$COUNT" -gt "$MAX" ]]; then
        #        BODY+=$'\n'
        BODY+="... e altre $((COUNT - MAX))"
    fi

    BODY+=$'\n\n'
    BODY+="$ICON_UNREAD Non letti: $UNREAD_COUNT"

    notify-send \
        -a "Mail" \
        " $COUNT nuove email" \
        $'\n'"$BODY"
fi

echo "$LATEST" >"$STATE_FILE"
